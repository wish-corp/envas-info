b\u57fa\u3065\u304f\u8868\u8a18\u306e\u30da\u30fc\u30b8\u3092\u79fb\u7ba1\u3057\u307e\u3057\u305f\u3002</p> \u30da\u30fc\u30b8 \u65e7\u30ea\u30f3\u30af \u65b0\u30ea\u30f3\u30af \u5229\u7528\u898f\u7d04 https://weddingvideowish.com/kiyaku https://envas.jp/terms \u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u30dd\u30ea\u30b7\u30fc https://weddingvideowish.com/privacy https://envas.jp/privacy \u7279\u5b9a\u5546\u53d6\u5f15\u6cd5\u306b\u57fa\u3065\u304f\u8868\u8a18\u306e\u30da\u30fc\u30b8 \u306a\u3057 https://envas.jp/legal <p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304f\u969b\u306f\u3001\u4e0a\u8a18\u306e\u65b0\u3057\u3044\u30ea\u30f3\u30af\u5148\u306e\u5185\u5bb9\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002 \u4eca\u5f8c\u3068\u3082 envas \u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/","title":"\u5229\u7528\u53ef\u80fd\u306a\u652f\u6255\u3044\u65b9\u6cd5\u306bApplePay\u3068PayPay\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/#applepay-paypay","title":"\u652f\u6255\u3044\u65b9\u6cd5\u306b ApplePay, PayPay \u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>\u3053\u306e\u8ffd\u52a0\u306b\u3088\u308a\u3001\u3053\u308c\u307e\u3067\u306f\u304a\u5ba2\u69d8\u306b\u3042\u3089\u304b\u3058\u3081\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u306e\u5165\u529b\u3092\u6c42\u3081\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u3053\u308c\u304b\u3089\u306f\u6599\u91d1\u306e\u304a\u652f\u6255\u3044\u6642\u306b\u90fd\u5ea6\u304a\u652f\u6255\u3044\u65b9\u6cd5\u304c\u9078\u629e\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002 \u65e2\u5b58\u306e\u652f\u6255\u3044\u65b9\u6cd5\u3067\u3042\u308b\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u6c7a\u6e08\u306f\u5f15\u304d\u7d9a\u304d\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p> <p>\u3053\u308c\u307e\u3067\u306b\u3054\u5229\u7528\u3044\u305f\u3060\u3044\u305f\u304a\u5ba2\u69d8\u306e\u4e2d\u306b\u306f\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u3092\u304a\u6301\u3061\u3067\u306a\u3044\u65b9\u3084\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u60c5\u5831\u306e\u5165\u529b\u306b\u4e0d\u5b89\u3092\u611f\u3058\u308b\u65b9\u3082\u3044\u3089\u3063\u3057\u3083\u3063\u305f\u304b\u3068\u601d\u3044\u307e\u3059\u3002 ApplePay \u3084 PayPay \u306e\u8ffd\u52a0\u306b\u3088\u308a\u3001\u305d\u3046\u3057\u305f\u304a\u5ba2\u69d8\u306b\u3082\u3088\u308a\u5b89\u5fc3\u3057\u3066\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002</p> <p>\u4eca\u5f8c\u3068\u3082 envas \u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/#_1","title":"\u8a73\u7d30","text":"<ul> <li>\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u6c7a\u6e08, ApplePay, PayPay \u306e\u3044\u305a\u308c\u304b\u3092\u9078\u629e\u3057\u3066\u304a\u652f\u6255\u3044\u3044\u305f\u3060\u3051\u307e\u3059\u3002</li> <li>\u652f\u6255\u3044\u65b9\u6cd5\u306e\u9078\u629e\u306f\u3001\u6599\u91d1\u306e\u304a\u652f\u6255\u3044\u6642\u306b\u884c\u3063\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3002</li> <li>\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u60c5\u5831\u306f envas \u306b\u306f\u4fdd\u5b58\u3055\u308c\u307e\u305b\u3093\u3002\uff08\u203b\u4e0a\u6d41\u6c7a\u6e08\u30b5\u30fc\u30d3\u30b9\u3067\u3042\u308b PAY.JP \u306b\u306f\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\uff09</li> </ul>"},{"location":"news/2026-03-24-add-guest-and-maintenance/","title":"\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u306e\u8ffd\u52a0\u3068\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u5b9f\u65bd\u306e\u3054\u5831\u544a","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-03-24-add-guest-and-maintenance/#_2","title":"\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>\u3053\u306e\u8ffd\u52a0\u306f\u3088\u308a\u826f\u3044\u4f53\u9a13\u3092\u65b0\u90ce\u65b0\u5a66\u306e\u304a\u4e8c\u4eba\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30b9\u30c8\u306e\u7686\u69d8\u306b\u3082\u5c55\u958b\u3057\u3066\u3044\u304f\u305f\u3081\u5b9f\u65bd\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002</p> <p>\u3053\u306e\u6a5f\u80fd\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u3088\u308a\u3001\u30b2\u30b9\u30c8\u306e\u767b\u9332\u3001\u66f4\u65b0\u3001\u524a\u9664\u304c\u5bb9\u6613\u306b\u306a\u3063\u305f\u3053\u3068\u306b\u52a0\u3048\u3066\u3001\u5e2d\u6b21\u8868\u7de8\u96c6\u6a5f\u80fd\u306e\u30e6\u30fc\u30b6\u30d3\u30ea\u30c6\u30a3\u30fc\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002</p> <p>\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u306b\u3064\u3044\u3066\u306e\u30d8\u30eb\u30d7\u306f\u3053\u3061\u3089\u3002 https://help.envas.jp/guest/</p> <p>\u5e2d\u6b21\u8868\u7de8\u96c6\u6a5f\u80fd\u306b\u3064\u3044\u3066\u306e\u30d8\u30eb\u30d7\u306f\u3053\u3061\u3089\u3002 https://help.envas.jp/seating-chart/</p>"},{"location":"news/2026-03-24-add-guest-and-maintenance/#_3","title":"\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u306b\u4f34\u3046\u5e2d\u6b21\u8868\u306e\u78ba\u8a8d\u306e\u304a\u9858\u3044","text":"<p>\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u306b\u4f34\u3046\u5e2d\u6b21\u8868\u306e\u78ba\u8a8d\u306e\u304a\u9858\u3044</p> <p>2026\u5e743\u670824\u65e5\uff08\u706b\uff09\u306b\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3092\u884c\u3044\u307e\u3057\u305f\u3002 \u65e2\u5b58\u306e\u5e2d\u6b21\u8868\u306e\u5185\u5bb9\u306b\u5f71\u97ff\u304c\u7121\u3044\u3088\u3046\u614e\u91cd\u306b\u4f5c\u696d\u3092\u884c\u3044\u307e\u3057\u305f\u304c\u3001\u4e07\u304c\u4e00\u3001\u5e2d\u6b21\u8868\u306e\u5185\u5bb9\u306b\u4e0d\u5177\u5408\u304c\u751f\u3058\u3066\u3044\u306a\u3044\u304b\u3054\u78ba\u8a8d\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002</p>"},{"location":"news/2026-03-27-add-after-party/","title":"\u4e8c\u6b21\u4f1a\u8a2d\u5b9a\u6a5f\u80fd\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p> <p>\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u306b\u4e8c\u6b21\u4f1a\uff08After Party\uff09\u306e\u60c5\u5831\u3092\u767b\u9332\u30fb\u8868\u793a\u3067\u304d\u308b\u6a5f\u80fd\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002</p>"},{"location":"news/2026-03-27-add-after-party/#_2","title":"\u6a5f\u80fd\u306e\u6982\u8981","text":"<p>\u30b5\u30a4\u30c9\u30d0\u30fc\u306e\u300c\u4e8c\u6b21\u4f1a\u300d\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u8a2d\u5b9a\u30da\u30fc\u30b8\u3092\u958b\u304d\u3001\u4e8c\u6b21\u4f1a\u306e\u60c5\u5831\u3092\u767b\u9332\u3067\u304d\u307e\u3059\u3002\u4fdd\u5b58\u3059\u308b\u3068\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\uff08\u7de8\u96c6\u753b\u9762\u30fb\u516c\u958b\u30da\u30fc\u30b8\uff09\u306b\u4e8c\u6b21\u4f1a\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u81ea\u52d5\u7684\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002</p> <p>\u672a\u8a2d\u5b9a\u306e\u5834\u5408\u3001\u4e8c\u6b21\u4f1a\u30bb\u30af\u30b7\u30e7\u30f3\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002</p>"},{"location":"news/2026-03-27-add-after-party/#_3","title":"\u5165\u529b\u9805\u76ee","text":"<p>\u4ee5\u4e0b\u306e\u9805\u76ee\u3092\u8a2d\u5b9a\u3067\u304d\u307e\u3059\u3002\u3059\u3079\u3066\u4efb\u610f\u5165\u529b\u3067\u3059\u3002</p> <ul> <li>\u30bf\u30a4\u30c8\u30eb - \u4e8c\u6b21\u4f1a\u306e\u30bf\u30a4\u30c8\u30eb</li> <li>\u4f1a\u8cbb - \u53c2\u52a0\u8cbb\u7528</li> <li>\u65e5\u6642 - \u958b\u50ac\u65e5\u6642</li> <li>\u4f1a\u5834\u540d - \u4e8c\u6b21\u4f1a\u306e\u4f1a\u5834\u540d</li> <li>\u4f4f\u6240 - \u4f1a\u5834\u306e\u4f4f\u6240\uff08\u5165\u529b\u3059\u308b\u3068 Google Maps \u30d7\u30ec\u30d3\u30e5\u30fc\u304c\u8868\u793a\u3055\u308c\u307e\u3059\uff09</li> <li>\u5099\u8003 - \u305d\u306e\u4ed6\u306e\u6848\u5185\u4e8b\u9805</li> </ul>"},{"location":"news/2026-03-27-add-after-party/#_4","title":"\u30d8\u30eb\u30d7\u30da\u30fc\u30b8","text":"<p>\u4e8c\u6b21\u4f1a\u8a2d\u5b9a\u6a5f\u80fd\u306e\u8a73\u3057\u3044\u4f7f\u3044\u65b9\u306f\u3001\u4ee5\u4e0b\u306e\u30d8\u30eb\u30d7\u30da\u30fc\u30b8\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\u3002</p> <p>https://help.envas.jp/after-party/</p>"},{"location":"news/2026-04-01-photo-gallery/","title":"\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u6a5f\u80fd\u3092\u30ea\u30ea\u30fc\u30b9\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-04-01-photo-gallery/#_2","title":"\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u6a5f\u80fd\u306b\u3064\u3044\u3066","text":"<p>\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u5185\u306b\u304a\u4e8c\u4eba\u306e\u5199\u771f\u3092\u63b2\u8f09\u3067\u304d\u308b\u300c\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u300d\u6a5f\u80fd\u3092\u30ea\u30ea\u30fc\u30b9\u3057\u307e\u3057\u305f\u3002 \u30b2\u30b9\u30c8\u306e\u5f85\u3061\u6642\u9593\u306b\u304a\u697d\u3057\u307f\u3044\u305f\u3060\u3051\u308b\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002</p>"},{"location":"news/2026-04-01-photo-gallery/#_3","title":"\u4e3b\u306a\u6a5f\u80fd","text":"<ul> <li>\u304a\u4e8c\u4eba\u306e\u5199\u771f\u3092\u6700\u59275\u679a\u307e\u3067\u767b\u9332\u3067\u304d\u307e\u3059</li> <li>\u30bf\u30a4\u30c8\u30eb\u3084\u30b2\u30b9\u30c8\u3078\u306e\u30b3\u30e1\u30f3\u30c8\u3092\u8a2d\u5b9a\u3067\u304d\u307e\u3059</li> <li>\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u5185\u306b\u30ab\u30eb\u30fc\u30bb\u30eb\u5f62\u5f0f\u3067\u63b2\u8f09\u3055\u308c\u307e\u3059</li> <li>\u8ffd\u52a0\u30aa\u30d7\u30b7\u30e7\u30f3\uff082,200\u5186\uff09\u3067\u6700\u592750\u679a\u307e\u3067\u62e1\u5f35\u3067\u304d\u307e\u3059</li> </ul>"},{"location":"news/2026-04-01-photo-gallery/#_4","title":"\u3054\u5229\u7528\u65b9\u6cd5","text":"<p>\u30b5\u30a4\u30c9\u30e1\u30cb\u30e5\u30fc\u306e\u300c\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u300d\u304b\u3089\u5199\u771f\u3084\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u8a2d\u5b9a\u3057\u3001\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u306e\u7de8\u96c6\u753b\u9762\u3067\u300c\u30d5\u30a9\u30c8\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u8868\u793a\u3059\u308b\u300d\u3092\u30aa\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p> <p>\u8a73\u3057\u3044\u4f7f\u3044\u65b9\u306f\u30d8\u30eb\u30d7\u30da\u30fc\u30b8\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\u3002 https://help.envas.jp/photo-gallery/</p>"},{"location":"news/2026-04-13-transaction-history/","title":"\u53d6\u5f15\u5c65\u6b74\u30da\u30fc\u30b8\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-04-13-transaction-history/#_2","title":"\u53d6\u5f15\u5c65\u6b74\u30da\u30fc\u30b8\u306e\u8ffd\u52a0","text":"<p>\u3054\u81ea\u8eab\u306e\u53d6\u5f15\u5c65\u6b74\u3092\u78ba\u8a8d\u3067\u304d\u308b\u300c\u53d6\u5f15\u5c65\u6b74\u300d\u30da\u30fc\u30b8\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002</p> <p>\u30b5\u30a4\u30c9\u30d0\u30fc\u306e\u300c\u305d\u306e\u4ed6\u306e\u8a2d\u5b9a\u300d\u304b\u3089\u300c\u53d6\u5f15\u5c65\u6b74\u300d\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u307e\u3067\u306e\u53d6\u5f15\u4e00\u89a7\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002</p>"},{"location":"news/2026-04-13-transaction-history/#_3","title":"\u4e3b\u306a\u6a5f\u80fd","text":"<ul> <li>\u53d6\u5f15\u4e00\u89a7\u306e\u8868\u793a: \u3053\u308c\u307e\u3067\u306e\u5168\u3066\u306e\u53d6\u5f15\u3092\u4e00\u89a7\u3067\u78ba\u8a8d\u3067\u304d\u307e\u3059</li> <li>\u53d6\u5f15\u7a2e\u5225\u30d5\u30a3\u30eb\u30bf: \u53d6\u5f15\u306e\u7a2e\u985e\u3054\u3068\u306b\u7d5e\u308a\u8fbc\u307f\u8868\u793a\u304c\u53ef\u80fd\u3067\u3059</li> <li>\u30ec\u30b9\u30dd\u30f3\u30b7\u30d6\u5bfe\u5fdc: \u30d1\u30bd\u30b3\u30f3\u3067\u306f\u30c6\u30fc\u30d6\u30eb\u5f62\u5f0f\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u306f\u30ab\u30fc\u30c9\u5f62\u5f0f\u3067\u898b\u3084\u3059\u304f\u8868\u793a\u3055\u308c\u307e\u3059</li> </ul> <p>\u3054\u5229\u7528\u65b9\u6cd5\u306e\u8a73\u7d30\u306f\u3001\u30d8\u30eb\u30d7\u30b5\u30a4\u30c8\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002 https://help.envas.jp/transaction-history/</p>"},{"location":"news/2026-05-04-guest-csv-import/","title":"\u30b2\u30b9\u30c8\u4e00\u89a7\u306e CSV \u30a4\u30f3\u30dd\u30fc\u30c8 / \u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u306b\u5bfe\u5fdc\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-05-04-guest-csv-import/#csv_1","title":"\u30b2\u30b9\u30c8\u60c5\u5831\u3092 CSV \u3067\u4e00\u62ec\u7ba1\u7406\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f","text":"<p>\u30b2\u30b9\u30c8\u4e00\u89a7\u30da\u30fc\u30b8\u3067\u3001CSV \u3092\u4f7f\u3063\u305f\u30b2\u30b9\u30c8\u306e\u4e00\u62ec\u767b\u9332\u3068\u4e00\u62ec\u66f4\u65b0\u304c\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002 \u4e8b\u524d\u306b\u307e\u3068\u3081\u3066\u304a\u304b\u308c\u305f\u30b2\u30b9\u30c8\u30ea\u30b9\u30c8\u3092\u305d\u306e\u307e\u307e\u53d6\u308a\u8fbc\u3093\u3060\u308a\u3001\u767b\u9332\u6e08\u307f\u306e\u30b2\u30b9\u30c8\u3092 CSV \u3067\u66f8\u304d\u51fa\u3057\u3066\u4e00\u62ec\u3067\u4fee\u6b63\u3057\u305f\u308a\u3068\u3044\u3063\u305f\u904b\u7528\u304c\u624b\u65e9\u304f\u884c\u3048\u307e\u3059\u3002</p> <p>\u30b2\u30b9\u30c8\u4e00\u89a7\u30da\u30fc\u30b8\u306e\u300c\u30a4\u30f3\u30dd\u30fc\u30c8\u300d\u300c\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u300d\u30dc\u30bf\u30f3\u304b\u3089\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p>"},{"location":"news/2026-05-04-guest-csv-import/#_1","title":"\u4e3b\u306a\u6a5f\u80fd","text":"<ul> <li>\u65b0\u898f\u4e00\u62ec\u767b\u9332:\u300c\u30a4\u30f3\u30dd\u30fc\u30c8\u300d\u30e2\u30fc\u30c0\u30eb\u304b\u3089\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8 CSV \u3092\u53d6\u5f97\u3057\u3001\u5fc5\u8981\u4e8b\u9805\u3092   \u57cb\u3081\u3066\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3059\u308b\u3068\u3001\u6700\u5927 500 \u4ef6\u307e\u3067\u4e00\u62ec\u3067\u767b\u9332\u3067\u304d\u307e\u3059</li> <li>\u4e00\u62ec\u66f4\u65b0:\u65e2\u306b\u30b2\u30b9\u30c8\u304c\u767b\u9332\u3055\u308c\u3066\u3044\u308b\u72b6\u614b\u3067\u300c\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u300d\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u3001   \u73fe\u5728\u306e\u30b2\u30b9\u30c8\u4e00\u89a7 CSV \u304c\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u307e\u3059\u3002CSV \u4e0a\u3067\u7de8\u96c6\u3057\u3066\u518d\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3059\u308b\u3068\u3001   \u30b2\u30b9\u30c8ID \u5217\u3067\u5bfe\u5fdc\u3059\u308b\u65e2\u5b58\u30b2\u30b9\u30c8\u304c\u307e\u3068\u3081\u3066\u66f4\u65b0\u3055\u308c\u307e\u3059</li> <li>\u67d4\u8edf\u306a\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f:UTF-8 / Shift_JIS \u306e\u3044\u305a\u308c\u306b\u3082\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059</li> <li>\u30a8\u30e9\u30fc\u884c\u306e\u8a73\u7d30\u8868\u793a:\u53d6\u308a\u8fbc\u3081\u306a\u304b\u3063\u305f\u884c\u306f\u3001\u884c\u756a\u53f7\u30fb\u5217\u540d\u30fb\u539f\u56e0\u3068\u3068\u3082\u306b\u4e00\u89a7\u8868\u793a\u3055\u308c\u307e\u3059</li> </ul>"},{"location":"news/2026-05-04-guest-csv-import/#_2","title":"\u30d8\u30c3\u30c0\u30fc\u306e\u4ed5\u69d8","text":"<p>CSV \u306e\u30d8\u30c3\u30c0\u30fc(1 \u884c\u76ee)\u306f <code>\u30b2\u30b9\u30c8ID,\u30b2\u30b9\u30c8\u540d,\u656c\u79f0,\u80a9\u66f8\u304d</code> \u56fa\u5b9a\u3067\u3059\u3002 <code>\u30b2\u30b9\u30c8ID</code> \u5217\u3092\u7a7a\u306b\u3059\u308b\u3068\u65b0\u898f\u767b\u9332\u3001\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3067\u53d6\u5f97\u3057\u305f\u65e2\u5b58\u306e ID \u3092\u6b8b\u3057\u3066\u304a\u304f\u3068 \u305d\u306e\u30b2\u30b9\u30c8\u306e\u66f4\u65b0\u306b\u306a\u308a\u307e\u3059\u3002</p> <p>\u3054\u5229\u7528\u65b9\u6cd5\u306e\u8a73\u7d30\u306f\u3001\u30d8\u30eb\u30d7\u30b5\u30a4\u30c8\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002 https://help.envas.jp/guest/#import-guests-csv</p>"},{"location":"news/2026-06-23-seating-chart-image/","title":"\u5e2d\u6b21\u8868\u753b\u50cf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u6a5f\u80fd\u3092\u30ea\u30ea\u30fc\u30b9\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>","tags":["\u65b0\u6a5f\u80fd"]},{"location":"news/2026-06-23-seating-chart-image/#_2","title":"\u5e2d\u6b21\u8868\u3092\u753b\u50cf\u3068\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f","text":"<p>\u5e2d\u6b21\u8868\u3092 PNG \u753b\u50cf\u3068\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u308b\u6a5f\u80fd\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002 \u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u305f\u753b\u50cf\u306f\u3001\u5370\u5237\u3057\u3066\u62ab\u9732\u5bb4\u4f1a\u5834\u306b\u63b2\u793a\u3057\u305f\u308a\u3001\u30b2\u30b9\u30c8\u3078\u306e\u6848\u5185\u306b\u6dfb\u4ed8\u3057\u305f\u308a\u3068\u3044\u3063\u305f\u7528\u9014\u306b\u304a\u4f7f\u3044\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p> <p>\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u306e\u5e2d\u6b21\u8868\u30ab\u30fc\u30c9\u3001\u307e\u305f\u306f\u30b5\u30a4\u30c9\u30e1\u30cb\u30e5\u30fc\u306e\u300c\u5e2d\u6b21\u8868\u753b\u50cf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u300d\u304b\u3089\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p>","tags":["\u65b0\u6a5f\u80fd"]},{"location":"news/2026-06-23-seating-chart-image/#_3","title":"\u4e3b\u306a\u6a5f\u80fd","text":"<ul> <li>\u30c6\u30fc\u30de \u00d7 \u30b9\u30bf\u30a4\u30eb\u306e\u7d44\u307f\u5408\u308f\u305b: \u5e2d\u6b21\u8868\u306e\u96f0\u56f2\u6c17\u3092\u8868\u3059\u30c6\u30fc\u30de\u3068\u3001\u5e2d\u6b21\u8868\u306e\u898b\u305f\u76ee\u3092\u8868\u3059\u30b9\u30bf\u30a4\u30eb\u3092\u81ea\u7531\u306b\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u30c6\u30fc\u30de\u6570\u2715\u30b9\u30bf\u30a4\u30eb\u6570\u306e\u7d44\u307f\u5408\u308f\u305b\u30d1\u30bf\u30fc\u30f3\u306e\u4e2d\u304b\u3089\u304a\u597d\u307f\u306e\u30c7\u30b6\u30a4\u30f3\u3092\u9078\u3079\u307e\u3059</li> <li>\u30d7\u30ec\u30d3\u30e5\u30fc\u3068\u62e1\u5927\u8868\u793a: \u753b\u50cf\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u62e1\u5927\u3057\u3066\u7d30\u90e8\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059</li> <li>\u81ea\u52d5\u30ec\u30a4\u30a2\u30a6\u30c8\u8abf\u6574: \u30c6\u30fc\u30d6\u30eb\u6570\u304c\u591a\u3044\u5834\u5408\u3067\u3082\u3001\u3059\u3079\u3066\u306e\u30c6\u30fc\u30d6\u30eb\u304c\u753b\u50cf\u5185\u306b\u53ce\u307e\u308b\u3088\u3046\u81ea\u52d5\u7684\u306b\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u6574\u3057\u307e\u3059</li> <li>\u4f55\u5ea6\u3067\u3082\u518d\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9: \u4e00\u5ea6\u3054\u8cfc\u5165\u3044\u305f\u3060\u3044\u305f\u5e2d\u6b21\u8868\u306f\u3001\u30c6\u30fc\u30de\u3084\u30b9\u30bf\u30a4\u30eb\u3092\u5909\u66f4\u3057\u3066\u3082\u8ffd\u52a0\u6599\u91d1\u306a\u3057\u3067\u4f55\u5ea6\u3067\u3082\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u307e\u3059</li> </ul>","tags":["\u65b0\u6a5f\u80fd"]},{"location":"news/2026-06-23-seating-chart-image/#sns","title":"SNS \u6295\u7a3f\u3067\u7121\u6599\u3067\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059","text":"<p>\u73fe\u5728\u3001SNS \u306b\u53e3\u30b3\u30df\u3092\u6295\u7a3f\u3044\u305f\u3060\u304f\u3060\u3051\u3067\u3001\u5e2d\u6b21\u8868\u753b\u50cf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u6a5f\u80fd\u3092\u7121\u6599\u3067\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p> <ol> <li>\u30da\u30fc\u30b8\u4e0b\u90e8\u306e\u300c\u5e2d\u6b21\u8868\u753b\u50cf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u300d\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059</li> <li>\u300c\u304a\u652f\u6255\u3044\u306b\u9032\u3080\u300d\u306e\u5de6\u96a3\u306b\u3042\u308b\u300c\u53e3\u30b3\u30df\u3067\u7121\u6599\u300d\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059</li> <li>instagram \u306a\u3069\u6295\u7a3f\u3057\u305f SNS \u306e\u30ea\u30f3\u30af\u3092\u5165\u529b\u3057\u3001\u300c\u9001\u4fe1\u3059\u308b\u300d\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059</li> <li>\u904b\u55b6\u304c SNS \u306e\u53e3\u30b3\u30df\u6295\u7a3f\u3092\u78ba\u8a8d\u6b21\u7b2c\u3001\u3054\u5229\u7528\u304c\u53ef\u80fd\u3067\u3059</li> </ol>","tags":["\u65b0\u6a5f\u80fd"]},{"location":"news/2026-06-23-seating-chart-image/#_4","title":"\u5e2d\u6b21\u8868\u30d3\u30e5\u30fc\u30ef\u306e\u524a\u9664\u306b\u3064\u3044\u3066","text":"<p>\u3053\u308c\u307e\u3067\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u7de8\u96c6\u753b\u9762\u306b\u8a2d\u7f6e\u3057\u3066\u3044\u305f\u5e2d\u6b21\u8868\u30d3\u30e5\u30fc\u30ef\uff08\u30c6\u30fc\u30d6\u30eb\u8a73\u7d30\u30e2\u30fc\u30c0\u30eb\u4ed8\u304d\u306e\u30d7\u30ec\u30d3\u30e5\u30fc\uff09\u306f\u3001\u4eca\u56de\u306e\u5e2d\u6b21\u8868\u753b\u50cf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u6a5f\u80fd\u3078\u306e\u7d71\u5408\u306b\u4f34\u3044\u524a\u9664\u3057\u307e\u3057\u305f\u3002\u5e2d\u6b21\u8868\u306e\u30d7\u30ec\u30d3\u30e5\u30fc\u306f\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u30d6\u30c3\u30af\u306e\u7de8\u96c6\u30da\u30fc\u30b8\u306e\u30d7\u30ec\u30d3\u30e5\u30fc\u30e2\u30fc\u30c9\u3084\u3001\u5e2d\u6b21\u8868\u753b\u50cf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u30da\u30fc\u30b8\u3067\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002</p>","tags":["\u65b0\u6a5f\u80fd"]},{"location":"news/2026-06-23-seating-chart-image/#_5","title":"\u3054\u5229\u7528\u65b9\u6cd5","text":"<p>\u3054\u5229\u7528\u65b9\u6cd5\u306e\u8a73\u7d30\u306f\u3001\u30d8\u30eb\u30d7\u30b5\u30a4\u30c8\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002 https://help.envas.jp/seating-chart-image/</p>","tags":["\u65b0\u6a5f\u80fd"]}]}
c\u3068\u3082 envas \u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/","title":"\u5229\u7528\u53ef\u80fd\u306a\u652f\u6255\u3044\u65b9\u6cd5\u306bApplePay\u3068PayPay\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/#applepay-paypay","title":"\u652f\u6255\u3044\u65b9\u6cd5\u306b ApplePay, PayPay \u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>\u3053\u306e\u8ffd\u52a0\u306b\u3088\u308a\u3001\u3053\u308c\u307e\u3067\u306f\u304a\u5ba2\u69d8\u306b\u3042\u3089\u304b\u3058\u3081\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u306e\u5165\u529b\u3092\u6c42\u3081\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u3053\u308c\u304b\u3089\u306f\u6599\u91d1\u306e\u304a\u652f\u6255\u3044\u6642\u306b\u90fd\u5ea6\u304a\u652f\u6255\u3044\u65b9\u6cd5\u304c\u9078\u629e\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002 \u65e2\u5b58\u306e\u652f\u6255\u3044\u65b9\u6cd5\u3067\u3042\u308b\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u6c7a\u6e08\u306f\u5f15\u304d\u7d9a\u304d\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p> <p>\u3053\u308c\u307e\u3067\u306b\u3054\u5229\u7528\u3044\u305f\u3060\u3044\u305f\u304a\u5ba2\u69d8\u306e\u4e2d\u306b\u306f\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u3092\u304a\u6301\u3061\u3067\u306a\u3044\u65b9\u3084\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u60c5\u5831\u306e\u5165\u529b\u306b\u4e0d\u5b89\u3092\u611f\u3058\u308b\u65b9\u3082\u3044\u3089\u3063\u3057\u3083\u3063\u305f\u304b\u3068\u601d\u3044\u307e\u3059\u3002 ApplePay \u3084 PayPay \u306e\u8ffd\u52a0\u306b\u3088\u308a\u3001\u305d\u3046\u3057\u305f\u304a\u5ba2\u69d8\u306b\u3082\u3088\u308a\u5b89\u5fc3\u3057\u3066\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002</p> <p>\u4eca\u5f8c\u3068\u3082 envas \u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002</p>"},{"location":"news/2026-02-14-add-applepay-and-paypay/#_1","title":"\u8a73\u7d30","text":"<ul> <li>\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u6c7a\u6e08, ApplePay, PayPay \u306e\u3044\u305a\u308c\u304b\u3092\u9078\u629e\u3057\u3066\u304a\u652f\u6255\u3044\u3044\u305f\u3060\u3051\u307e\u3059\u3002</li> <li>\u652f\u6255\u3044\u65b9\u6cd5\u306e\u9078\u629e\u306f\u3001\u6599\u91d1\u306e\u304a\u652f\u6255\u3044\u6642\u306b\u884c\u3063\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3002</li> <li>\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u60c5\u5831\u306f envas \u306b\u306f\u4fdd\u5b58\u3055\u308c\u307e\u305b\u3093\u3002\uff08\u203b\u4e0a\u6d41\u6c7a\u6e08\u30b5\u30fc\u30d3\u30b9\u3067\u3042\u308b PAY.JP \u306b\u306f\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\uff09</li> </ul>"},{"location":"news/2026-03-24-add-guest-and-maintenance/","title":"\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u306e\u8ffd\u52a0\u3068\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u5b9f\u65bd\u306e\u3054\u5831\u544a","text":"<p>envas \u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002</p>"},{"location":"news/2026-03-24-add-guest-and-maintenance/#_2","title":"\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f","text":"<p>\u3053\u306e\u8ffd\u52a0\u306f\u3088\u308a\u826f\u3044\u4f53\u9a13\u3092\u65b0\u90ce\u65b0\u5a66\u306e\u304a\u4e8c\u4eba\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30b9\u30c8\u306e\u7686\u69d8\u306b\u3082\u5c55\u958b\u3057\u3066\u3044\u304f\u305f\u3081\u5b9f\u65bd\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002</p> <p>\u3053\u306e\u6a5f\u80fd\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u3088\u308a\u3001\u30b2\u30b9\u30c8\u306e\u767b\u9332\u3001\u66f4\u65b0\u3001\u524a\u9664\u304c\u5bb9\u6613\u306b\u306a\u3063\u305f\u3053\u3068\u306b\u52a0\u3048\u3066\u3001\u5e2d\u6b21\u8868\u7de8\u96c6\u6a5f\u80fd\u306e\u30e6\u30fc\u30b6\u30d3\u30ea\u30c6\u30a3\u30fc\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002</p> <p>\u30b2\u30b9\u30c8\u7ba1\u7406\u6a5f\u80fd\u306b\u3064\u3044\u3066\u306e\u30d8\u30eb\u30d7\u306f\u3053\u3061\u3089\u3002 https://help.envas.jp/guest/</p> <p>\u5e2d\u6b21\u8868\u7de8\u96c6\u6a5f\u80fd\u306b\u3064\u3044\u3066\u306e\u30d8\u30eb\u30d7\u306f\u3053\u3061\u3089\u3002 https://help.envas.jp/seating-chart/</p>"},{"location":"news/2026-03-24-add-guest-and-maintenance/#_3","title":"\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u306b\u4f34\u3046\u5e2d\u6b21\u8868\u306e\u78ba\u8a8d\u306e\u304a\u9858\u3044","text":"<p>\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u306b\u4f34\u3046\u5e2d\u6b21\u8868\u306e\u78ba\u8a8d\u306e\u304a\u9858\u3044</p> <p>2026\u5e743\u670824\u65e5\uff08\u706b\uff09\u306b\u30b7\u30b9\u30c6\u30e0\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3092\u884c\u3044\u307e\u3057\u305f\u3002 \u65e2\u5b58\u306e\u5e2d\u6b21\u8868\u306e\u5185\u5bb9\u306b\u5f71\u97ff\u304c\u7121\u3044\u3088\u3046\u614e\u91cd\u306b\u4f5c\u696d\u3092\u884c\u3044\u307e\u3057\u305f\u304c\u3001\u4e07\u304c\u4e00\u3001\u5e2d\u6b21\u8868\u306e\u5185\u5bb9\u306b\u4e0d\u5177\u5408\u304c\u751f\u3058\u3066\u3044\u306a\u3044\u304b\u3054\u78ba\u8a8d\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002</p>"}]}